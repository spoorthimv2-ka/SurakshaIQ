# App Config
ENVIRONMENT=production
LOG_LEVEL=INFO
DEBUG=false
API_V1_STR=/api/v1

# Zoho Catalyst
CATALYST_PROJECT_ID=
CATALYST_ENVIRONMENT=Production
CATALYST_APP_KEY=<your_app_key>
CATALYST_APP_SECRET=<your_app_secret>

# Catalyst Authentication
CATALYST_AUTH={"refresh_token":"","client_id":"","client_secret":""}

# Catalyst AI
AI_PROVIDER=catalyst
AI_MODEL=glm

# JWT (keep for backward compatibility)
JWT_SECRET_KEY=<your_jwt_secret>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Security
DEV_SKIP_AUTH=false
MOCK_CATALYST_DATA=false
CORS_ORIGINS=[]
